Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Siempre por https
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /blog → /blog/index.html (excepción necesaria porque blog/ es directorio)
RewriteRule ^blog$ /blog/index.html [L]

# URLs limpias: cualquier ruta sin extensión → .html equivalente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Seguridad
<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Archivos internos que no se publican
RedirectMatch 404 ^/(supabase|\.claude)(/|$)
<FilesMatch "^(\.DS_Store|CLAUDE\.md|README\.md|netlify\.toml)$">
  Require all denied
</FilesMatch>

# Cache de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType font/woff2               "access plus 1 year"
</IfModule>
