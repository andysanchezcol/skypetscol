Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Siempre por https
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /admin/ (marcadores viejos, antes era el catálogo) → portal de documentos
RewriteRule ^admin/?$ /admin.html [L,R=301]

# /blog → /blog/index.html (excepción necesaria porque blog/ es directorio)
RewriteRule ^blog$ /blog/index.html [L]

# URLs limpias: cualquier ruta sin extensión → .html equivalente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Seguridad
<IfModule mod_headers.c>
  Header set X-Frame-Options "DENY"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://app.konexa.com.co; style-src 'self' 'unsafe-inline' https://app.konexa.com.co; img-src 'self' data: blob: https:; media-src 'self' blob: https://jkrcdsneilbnuwvqgjba.supabase.co; font-src 'self' data:; connect-src 'self' https://jkrcdsneilbnuwvqgjba.supabase.co wss://jkrcdsneilbnuwvqgjba.supabase.co https://api.eclipseagency.com.co https://app.konexa.com.co https://cdn.jsdelivr.net; frame-src https://app.konexa.com.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>

# Archivos internos que no se publican
RedirectMatch 404 ^/(supabase|\.claude)(/|$)
<FilesMatch "^(\.DS_Store|CLAUDE\.md|README\.md|netlify\.toml)$">
  Require all denied
</FilesMatch>

# Cache de assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType text/css                 "access plus 1 month"
  ExpiresByType application/javascript   "access plus 1 month"
  ExpiresByType font/woff2               "access plus 1 year"
</IfModule>
