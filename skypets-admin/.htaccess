Options -Indexes

# Siempre por https
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
DirectoryIndex index.php

# Proteger archivos sensibles
<FilesMatch "\.(json|log|sh|env|sql|md|phar|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Documentos de la veterinaria: el PDF los lee del disco, nunca por web
<FilesMatch "^(cedula\.jpg|firma\.png|tarjeta\.jpg|instalar_fpdi\.php|composer-setup\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Carpetas internas: nada de esto se sirve por web (el PHP las lee del disco)
RewriteRule ^(vendor|tmp|templates|credentials)(/|$) - [F,L]

# Archivos PHP que solo se incluyen desde otros (configuración, base, sesión, ayudas): no se piden directo
<FilesMatch "^(config|konexa_config|konexa_config\.example|db|auth|helpers|google_api|ratelimit)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Encabezados de seguridad (always: salen también en 301/403/500)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=()"
    # CSP solo en páginas HTML: el visor de PDF del navegador no siempre convive con una CSP en el propio PDF.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" "expr=%{CONTENT_TYPE} =~ m#^text/html#i"
</IfModule>
